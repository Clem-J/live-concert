{
  "permissions": {
    "allow": [
      "Bash(lsof -ti:3000)",
      "Bash(xargs kill -9)",
      "Bash(node server.js)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/watch)",
      "Bash(curl -s -o /dev/null -w \"/ → %{http_code}\\\\n\" http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"/watch → %{http_code}\\\\n\" http://localhost:3000/watch)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  }
}
